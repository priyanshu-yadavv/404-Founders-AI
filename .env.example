# 404 FOUNDERS — ENVIRONMENT VARIABLE CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit .env or secrets to Git.

# Operational Environment: development | staging | production
FOUNDERS_ENV=development
FOUNDERS_LOG_LEVEL=INFO
FOUNDERS_LOG_FORMAT=json

# System Mode: general | personal | hybrid
FOUNDERS_OPERATING_MODE=hybrid

# Security & Permissions
# Levels: read_only | protected | privileged | dangerous
FOUNDERS_SECURITY_DEFAULT_TIER=read_only
FOUNDERS_REQUIRE_USER_CONFIRMATION=true
FOUNDERS_AUDIT_LOG_ENABLED=true
FOUNDERS_AUDIT_LOG_PATH=logs/security_audit.log

# API Gateway Configuration
FOUNDERS_REST_HOST=127.0.0.1
FOUNDERS_REST_PORT=8000
FOUNDERS_WS_PORT=8001
FOUNDERS_GRPC_PORT=50051

# Compute & Framework Selection
# Backend: cpu | cuda | jax
FOUNDERS_COMPUTE_BACKEND=cpu
FOUNDERS_MAX_LOCAL_MEMORY_MB=4096
FOUNDERS_MAX_CPU_THREADS=8

# Distributed GPU Cluster Target (For Cloud / HPC Training)
FOUNDERS_CLUSTER_MASTER_ADDR=
FOUNDERS_CLUSTER_MASTER_PORT=29500
FOUNDERS_CLUSTER_WORLD_SIZE=1

# External AI Provider Keys (Optional Hybrid Cloud Routing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
